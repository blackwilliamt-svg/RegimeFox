# ---------------------------------------------------------------------------
# Solana TA Bot - environment. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- API keys -------------------------------------------------------------
# Jupiter: https://portal.jup.ag  (Developer Platform -> create key)
# NOTE: keyless works at 0.5 RPS. Free key = 1 RPS. Developer ($25/mo) = 10 RPS.
#       The two-tier scan cadence needs ~10 RPS to run as specified.
JUPITER_API_KEY=

# Birdeye: https://bds.birdeye.so  (verify email first, then Security -> Generate Key)
BIRDEYE_API_KEY=

# RugCheck is keyless for the public report endpoints. Leave blank unless you
# have been issued a JWT.
RUGCHECK_API_KEY=

# --- Wallet ---------------------------------------------------------------
# Base58 secret key for a DEDICATED, FRESHLY GENERATED hot wallet.
# Generate with:  python manage.py new-wallet
# NEVER paste a Phantom / personal wallet key here.
# Only required when TRADING_MODE=live. Leave blank for paper trading.
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Web dashboard --------------------------------------------------------
# Generate with:  python -c "import secrets;print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Encryption key for at-rest secrets stored in the DB (rotated API keys).
# Generate with:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_ENCRYPTION_KEY=

# --- Paths ----------------------------------------------------------------
SOLBOT_DB=data/solbot.db
SOLBOT_CONFIG=config.json
