# ---------------------------------------------------------------------------
# Solana TA Bot - environment. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- API keys -------------------------------------------------------------
# Jupiter: https://portal.jup.ag  (Developer Platform -> create key)
# NOTE: keyless works at 0.5 RPS. Free key = 1 RPS. Developer ($25/mo) = 10 RPS.
#       The two-tier scan cadence needs ~10 RPS to run as specified.
JUPITER_API_KEY=

# Binance.US needs no key - universe ranking and candle history (klines) are
# both keyless public endpoints. This bot talks to Binance.US, not global
# Binance, since global Binance geo-blocks US-origin traffic.

# RugCheck is keyless for the public report endpoints. Leave blank unless you
# have been issued a JWT.
RUGCHECK_API_KEY=

# Bearer token a RunPod worker presents when it reports a monthly retest's
# progress back to this droplet. Generate it from the dashboard (Settings ->
# RunPod worker token) rather than inventing one; a rotated token stored there
# takes precedence over this. It grants write access to the run feed and
# bundle submission only - nothing else.
BULK_DATA_TOKEN=

# RunPod: https://www.runpod.io/console/user/settings (API Keys)
# Only needed for the monthly full parameter-space retest, which the droplet
# orchestrates on a RunPod GPU worker. Leave blank and the monthly run is
# simply not available; the daily on-droplet incremental search still runs.
RUNPOD_API_KEY=

# S3-compatible network-volume credentials for shipping candle data to a
# RunPod worker. Only needed alongside RUNPOD_API_KEY, above.
RUNPOD_S3_ACCESS_KEY=
RUNPOD_S3_SECRET_KEY=

# --- Wallet ---------------------------------------------------------------
# Base58 secret key for a DEDICATED, FRESHLY GENERATED hot wallet.
# Generate with:  python manage.py new-wallet
# NEVER paste a Phantom / personal wallet key here.
# Only required when TRADING_MODE=live. Leave blank for paper trading.
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Web dashboard --------------------------------------------------------
# Generate with:  python -c "import secrets;print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Encryption key for at-rest secrets stored in the DB (rotated API keys).
# Generate with:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_ENCRYPTION_KEY=

# --- Paths ----------------------------------------------------------------
SOLBOT_DB=data/solbot.db
SOLBOT_CONFIG=config.json
